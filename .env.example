# Qloo hackathon key. Leave blank to run the labeled fixture graph.
# Request a key: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
QLOO_API_KEY=

# Hackathon keys only work against this host. The server rejects any URL that is not https on a qloo.com host.
QLOO_API_URL=https://hackathon.api.qloo.com

# auto: live when QLOO_API_KEY is set, otherwise mock.
# mock: always fixtures, even if a key is present.
# live: require a key.
QLOO_MODE=auto

# Optional model. The room still compiles with none of these set.
# LLM_PROVIDER: openai | anthropic | gateway
# If LLM_PROVIDER is empty, the first available key below is used.
LLM_PROVIDER=
LLM_MODEL=
# Generic fallback used when the provider-specific key is empty.
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# off | webhook | hue | home_assistant
# Default off. Judges can use the hosted demo without this.
ATMOSPHERE_DISPATCH=off
# When true, and the target is fully configured, compile also pushes the palette.
ATMOSPHERE_DISPATCH_AUTO=false

# Public URL that accepts POST JSON. Use this for a hosted demo.
# A Philips Hue bridge is LAN-only and is not reachable from Vercel.
DISPATCH_WEBHOOK_URL=

HUE_BRIDGE_HOST=
HUE_USERNAME=
HUE_GROUP_ID=0

HA_BASE_URL=
HA_TOKEN=
HA_ENTITY_ID=
